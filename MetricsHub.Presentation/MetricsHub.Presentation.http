@MetricsHub.Presentation_HostAddress = http://localhost:8080

### Create pulse event
# Sends a pulse ingestion event to the API
# Expected response: HTTP 202 Accepted

POST {{MetricsHub.Presentation_HostAddress}}/api/events
Content-Type: application/json
X-Source: Pulse

{
  "pulse_id": "p-88a1c3e8",
  "ts": "2026-05-07T14:32:01.442Z",
  "node": "worker-us-east-07",
  "region": "us-east-1",
  "metrics": {
    "cpu_pct": 72.4,
    "mem_mb": 3021,
    "active_conns": 148,
    "status": "healthy"
  },
  "tags": ["production", "tier-1"]
}

### Create alert event
# Sends an alert ingestion event to the API
# Expected response: HTTP 202 Accepted

POST {{MetricsHub.Presentation_HostAddress}}/api/events
Content-Type: application/json
X-Source: Alert

{
    "alert_id": "a-44f1-9bc8",
    "fired_at": "2026-05-07T14:32:18Z",
    "resource": {
        "name": "worker-us-east-07",
        "group": "us-east-1",
        "environment": "production"
    },
    "rule": {
        "name": "High CPU",
        "threshold": 70.0,
        "actual": 72.4,
        "metric": "cpu_pct",
        "severity": "warning"
    },
    "correlation_id": "p-88a1c3e7"
}

### Get specific event including related ones (correlationId)
# IncludeRelated prop only works for specific events to avoid overloading the db

POST {{MetricsHub.Presentation_HostAddress}}/api/events/search
Content-Type: application/json

{
    "EventId": "p-88a1c3e7",
    "IncludeRelated": true
}

### Get paginated data

POST {{MetricsHub.Presentation_HostAddress}}/api/events/search
Content-Type: application/json
X-Source: Pulse

{
    "SourceSystem": "pulse",
    "pagination": {
        "pageNumber": 1,
         "pageSize": 2
    }    
}